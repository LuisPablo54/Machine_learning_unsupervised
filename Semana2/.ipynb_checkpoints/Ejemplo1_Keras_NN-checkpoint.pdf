   "metadata": {},
   "outputs": [],
   "source": [
    "# Ejemplo con Keras para Imagen de numeros escritos a mano (MNIST)\n",
    "import tensorflow as tf\n",
    "from keras.models import Sequential\n",
    "from keras.layers import Dense, Flatten\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "afd55f6e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dimensiones de X_train (Imagenes de entrenamiento): (60000, 28, 28)\n",
      "Dimensiones de X_test (Imagenes de prueba): (10000, 28, 28)\n",
      "Dimensiones de y_train (Etiquetas de entrenamiento): (60000,)\n",
      "Dimensiones de y_test (Etiquetas de prueba): (10000,)\n"
     ]
    }
   ],
   "source": [
    "mnist = tf.keras.datasets.mnist\n",
    "\n",
    "(X_train, y_train), (X_test, y_test) = mnist.load_data()\n",
    "\n",
    "print(f\"Dimensiones de X_train (Imagenes de entrenamiento): {X_train.shape}\")\n",
    "print(f\"Dimensiones de X_test (Imagenes de prueba): {X_test.shape}\")\n",
    "print(f\"Dimensiones de y_train (Etiquetas de entrenamiento): {y_train.shape}\")\n",
    "print(f\"Dimensiones de y_test (Etiquetas de prueba): {y_test.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "37df8b57",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 300x300 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Visualizar imagenes del dataset\n",
    "\n",
    "indice = 4\n",
    "plt.figure(figsize=(3, 3))\n",
    "plt.imshow(X_train[indice], cmap='gray')\n",
    "plt.title(f'Etiqueta Real: {y_train[indice]}')\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "720cc0e8",
   "metadata": {},
