   "source": [
    "# Arquitectura del modelo, ahora con  Ahora con 10 capas con 4 nueronas cada una\n",
    "# Importamos BatchNormalization para ayudar contra el problema de vanishing gradient\n",
    "from keras.layers import BatchNormalization\n",
    "model_mnist = Sequential()\n",
    "\n",
    "# Capa de entrada\n",
    "model_mnist.add(Flatten(input_shape=(28, 28)))\n",
    "\n",
    "# 10 capas ocultas con 4 neuronas cada una\n",
    "for _ in range(10):\n",
    "    model_mnist.add(Dense(32, activation='relu', kernel_initializer='he_normal'))\n",
    "    #model_mnist.add(BatchNormalization())  # Noramlización modificando la salida de cada capa para evitar el problema de vanishing gradient\n",
    "\n",
    "# Capa de salida\n",
    "model_mnist.add(Dense(10, activation='softmax'))\n",
    "\n",
    "model_mnist.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "31d80e3d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WARNING:tensorflow:TensorFlow GPU support is not available on native Windows for TensorFlow >= 2.11. Even if CUDA/cuDNN are installed, GPU will not be used. Please use WSL2 or the TensorFlow-DirectML plugin.\n"
     ]
    }
   ],
   "source": [
    "# Configurar\n",
    "model_mnist.compile(\n",
    "    optimizer='adam', # Optimizador\n",
    "    loss='sparse_categorical_crossentropy', # Función de pérdida\n",
    "    metrics=['accuracy']  # Métrica de evaluación\n",
    ")"
   ]
  },
