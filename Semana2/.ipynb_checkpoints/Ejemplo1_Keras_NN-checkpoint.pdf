   "source": [
    "# Visualizar una muestra aletoria del datase\n",
    "# Al usar:indice = np.random.randint(0, len(X_test)) se selecciona una imagen \n",
    "# aleatoria del conjunto de prueba para visualizarla. Esto permite ver cómo el \n",
    "# modelo clasifica esa imagen específica y comparar la etiqueta real con la predicción del modelo.\n",
    "Indice = 15\n",
    "prediccion_probablidades = model_mnist.predict(X_test[Indice:Indice+1]) # Predice la probabilidad de cada clase para la imagen seleccionada\n",
    "prediccion_clase = np.argmax(prediccion_probablidades) # Toma la clase con la probabilidad más alta como la predicción final\n",
    "plt.figure(figsize=(3, 3))\n",
    "plt.imshow(X_test[Indice], cmap='gray')\n",
    "plt.title(f'Etiqueta Real: {y_test[Indice]}, Predicción: {prediccion_clase}')\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
