      "  super().__init__(**kwargs)\n"
     ]
    }
   ],
   "source": [
    "# Normalizar los datos\n",
    "X_train = X_train / 255.0\n",
    "X_test = X_test / 255.0\n",
    "# Construir el modelo\n",
    "model = Sequential([\n",
    "    Flatten(input_shape=(28, 28)),\n",
    "    Dense(128, activation='relu'),\n",
    "    Dense(10, activation='softmax')\n",
    "])\n"
   ]
  },
